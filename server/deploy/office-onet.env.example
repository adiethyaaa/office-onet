# Contoh berkas env untuk layanan office-onet di VPS.
# Berkas ini hanya berisi NAMA variabel, tanpa nilai apa pun.
# Salin menjadi ~/office-onet/data/office-onet.env di VPS (mode 0600),
# isi nilainya di sana, dan jangan pernah menaruh berkas yang sudah
# diisi di repo atau di chat.
#
# Alamat dan token API Pokja (sama seperti yang dipakai agen Kasuari).
POKJA_API_URL=
POKJA_API_TOKEN=
#
# Origin publik office (harus sama persis dengan hostname pada
# konfigurasi Tunnel; dipakai server untuk menerima POST).
KANTOR_RPG_ORIGIN=
#
# Kosongkan (jangan diisi) untuk penyebaran Tunnel: bila variabel ini
# diisi, main.mjs memakai nilainya sebagai rahasia proxy. Untuk
# penyebaran nginx, isikan rahasia yang sama dengan yang dipakai
# konfigurasi nginx. Lihat docs/DEPLOY-VPS.md.
KANTOR_RPG_PROXY_SECRET=
